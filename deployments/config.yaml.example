# DB9 Configuration File Example
# Copy this file to config.yaml and adjust values as needed
# Set CONFIG_FILE environment variable to point to your config file
# Environment variables override values in this file

server:
  port: "8080"
  host: "localhost"
  timeout: 30

database:
  driver: "postgres"
  host: "localhost"
  port: 5432
  user: "db9"
  password: ""
  database: "db9"

auth:
  secret: ""  # IMPORTANT: Set via environment variable for production
  expires_in: 3600

cors:
  allowed_origins: "http://localhost:3000,http://localhost:8080"
  allowed_methods: "GET,POST,PUT,DELETE,OPTIONS"
  allowed_headers: "Content-Type,Authorization"
  exposed_headers: ""
  allow_credentials: false
  max_age: 86400

rate_limit:
  enabled: false
  requests_per_minute: 100
  burst: 20
